{
	"name": "@toreda/time",
	"version": "0.3.2",
	"description": "Lightweight time math for TypeScript & JavaScript. Convert between time units from microseconds to years, parse duration and date strings, compute time since, until, and now, and run timers with pause and event callbacks. Ships dual ESM + CJS builds.",
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"typings": "./dist/cjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"directories": {
		"test": "tests"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "pnpm build:prod",
		"build:prod": "pnpm gulp --prod",
		"build:dev": "pnpm gulp --dev",
		"test": "cross-env COVERAGE=full jest --coverage",
		"test:ci": "cross-env COVERAGE=full jest --ci --coverage --maxWorkers=50% --reporters=default --reporters=jest-junit",
		"test:fast": "cross-env COVERAGE=summary jest --bail --coverage",
		"test:silent": "pnpm jest --coverage=false --maxWorkers=50% --silent --verbose=false",
		"make:docs": "pnpm typedoc docs --categorizeByGroup false --entryPoints ./src/index.ts",
		"make:depgraph": "pnpm madge src/index.ts --image dependency-graph.png"
	},
	"packageManager": "pnpm@12.4.2",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/toreda/time.git"
	},
	"keywords": [
		"time",
		"time-math",
		"time-units",
		"time-conversion",
		"unit-conversion",
		"duration",
		"duration-parsing",
		"date",
		"date-parsing",
		"timestamp",
		"unix-timestamp",
		"time-since",
		"time-until",
		"timer",
		"moment",
		"moment-alternative",
		"typescript",
		"javascript",
		"esm",
		"cjs",
		"tree-shaking",
		"toreda"
	],
	"author": "Toreda, Inc.",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/toreda/time/issues"
	},
	"prettier": "@toreda/prettier-config",
	"homepage": "https://github.com/toreda/time#readme",
	"devDependencies": {
		"@jest/types": "^30.5.1",
		"@swc/core": "^1.16.2",
		"@swc/jest": "^0.2.39",
		"@toreda/build-tools": "^0.8.0",
		"@toreda/eslint-config": "^4.0.0",
		"@toreda/log": "^1.0.0",
		"@toreda/prettier-config": "^2.0.0",
		"@toreda/types": "^2.16.0",
		"@types/gulp": "^4.0.18",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.6.0",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"cross-env": "^10.1.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"gulp": "^4.0.2",
		"jest": "^30.5.2",
		"jest-junit": "^17.0.0",
		"madge": "^8.0.0",
		"mockdate": "^3.0.5",
		"prettier": "^3.9.8",
		"ts-node": "^10.9.2",
		"typedoc": "^0.24.6",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@toreda/shared-types": "^3.0.0"
	}
}
