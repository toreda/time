{
	"name": "@toreda/time",
	"version": "0.2.0",
	"description": "Simple, small footprint library for common time operations and converting between units of time. ",
	"main": "./dist/index",
	"typings": "./dist/index.d.ts",
	"sideEffects": false,
	"directories": {
		"test": "tests"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "pnpm build:prod",
		"build:prod": "pnpm gulp --prod",
		"build:dev": "pnpm gulp --dev",
		"test": "cross-env COVERAGE=full jest --coverage",
		"test:ci": "cross-env COVERAGE=full jest --ci --coverage --maxWorkers=50% --reporters=default --reporters=jest-junit",
		"test:fast": "cross-env COVERAGE=summary jest --bail --coverage",
		"test:silent": "pnpm jest --coverage=false --maxWorkers=50% --silent --verbose=false",
		"make:docs": "pnpm typedoc docs --categorizeByGroup false --entryPoints ./src/index.ts",
		"make:depgraph": "pnpm madge src/index.ts --image dependency-graph.png"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/toreda/time.git"
	},
	"keywords": [
		"time",
		"timestamp",
		"date",
		"moment",
		"moment.js",
		"typescript",
		"toreda"
	],
	"author": "Toreda, Inc.",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/toreda/time/issues"
	},
	"resolutions": {
		"glob-parent": "^5.1.2",
		"nanoid": "^3.1.31",
		"marked": "^4.0.10",
		"postcss": "^8.2.13"
	},
	"pnpm": {
		"overrides": {
			"jest": "^30.3.0",
			"jest-cli": "^30.3.0",
			"jest-runtime": "^30.3.0",
			"jest-config": "^30.3.0",
			"@jest/core": "^30.3.0",
			"@jest/types": "^30.3.0",
			"@jest/transform": "^30.3.0",
			"@jest/environment": "^30.3.0",
			"@jest/globals": "^30.3.0"
		}
	},
	"prettier": "@toreda/prettier-config",
	"homepage": "https://github.com/toreda/time#readme",
	"devDependencies": {
		"@swc/core": "^1.15.33",
		"@swc/jest": "^0.2.39",
		"@toreda/build-tools": "^0.8.0",
		"@toreda/eslint-config": "^2.2.0",
		"@toreda/log": "^0.6.16",
		"@toreda/prettier-config": "^1.0.1",
		"@toreda/types": "^2.16.0",
		"@types/gulp": "^4.0.18",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.6.0",
		"@typescript-eslint/eslint-plugin": "^5.59.2",
		"@typescript-eslint/parser": "^5.59.2",
		"cross-env": "^10.1.0",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"gulp": "^4.0.2",
		"jest": "^30.3.0",
		"jest-sonar-reporter": "^2.0.0",
		"madge": "^8.0.0",
		"mockdate": "^3.0.5",
		"prettier": "^2.8.8",
		"ts-node": "^10.9.1",
		"typedoc": "^0.24.6",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"marked": "^4.0.10",
		"nanoid": "^3.1.31",
		"postcss": "^8.2.13"
	}
}
